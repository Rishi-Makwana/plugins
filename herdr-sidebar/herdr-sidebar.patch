+#[test]
+fn spaces_and_agents_split_the_height_left_above_stats_and_launchers() {
+    let mut config = ClientShellConfig::from_config(&Config::default());
+    config.custom.command = "stats".into();
+    let mut state = ClientShellState::new(config);
+    let mut snapshot = snapshot();
+    snapshot.sidebar_custom_lines = vec!["cpu 12%".into(), "mem 58%".into()];
+    for index in 0..4 {
+        snapshot.commands.push(launcher_command(
+            &format!("cmd_launch_{index}"),
+            "C",
+            "Chrome",
+        ));
+    }
+    state.set_snapshot(Box::new(snapshot));
+    state.set_pane_surface(surface());
+    state.compose(106, 30).expect("split frame");
+
+    // Launchers take 2 + 2 * 2 rows and stats 2 + 2 rows, leaving 20 rows split 10/10.
+    assert_eq!(state.hits.sidebar_split_area.height, 20);
+    let divider = state.hits.sidebar_section_divider;
+    assert_eq!(divider.y, 10);
+    assert!(state.hits.launchers.iter().all(|(rect, _)| rect.y >= 24));
+
+    state.handle_raw_events(vec![RawInputEvent::Mouse(crossterm::event::MouseEvent {
+        kind: MouseEventKind::Down(MouseButton::Left),
+        column: divider.x + 2,
+        row: divider.y,
+        modifiers: KeyModifiers::empty(),
+    })]);
+    state.handle_raw_events(vec![RawInputEvent::Mouse(crossterm::event::MouseEvent {
+        kind: MouseEventKind::Drag(MouseButton::Left),
+        column: divider.x + 2,
+        row: 5,
+        modifiers: KeyModifiers::empty(),
+    })]);
+    assert!(
+        (state.sidebar_section_split - 0.25).abs() < 0.01,
+        "drag maps onto the spaces/agents area, got {}",
+        state.sidebar_section_split
+    );
+}
