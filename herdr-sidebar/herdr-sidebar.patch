+) -> (Rect, Rect) {
+    if config.custom.command.trim().is_empty() {
+        return (area, Rect::default());
+    }
+    let line_rows = snapshot
+        .sidebar_custom_lines
+        .len()
+        .min(usize::from(config.custom.max_rows)) as u16;
+    let height = (CUSTOM_SECTION_HEADER_ROWS + line_rows)
+        .min(area.height.saturating_sub(MIN_SPACES_AND_AGENTS_ROWS));
+    if height < CUSTOM_SECTION_HEADER_ROWS {
+        return (area, Rect::default());
+    }
+    let agents = Rect {
+        height: area.height - height,
+        ..area
+    };
+    let custom = Rect::new(area.x, agents.bottom(), area.width, height);
+    (agents, custom)
+}
+
+fn render_custom_section(
+    buffer: &mut Buffer,
+    area: Rect,
+    snapshot: &ClientShellSnapshot,
+    config: &ClientShellConfig,
+) {
+    if area.height < CUSTOM_SECTION_HEADER_ROWS {
+        return;
+    }
+    let palette = &config.palette;
+    put_text(
+        buffer,
+        area.x,
+        area.y,
+        area.width,
+        &"─".repeat(area.width as usize),
+        Style::default().fg(palette.surface_dim),
+    );
+    put_text(
+        buffer,
+        area.x,
+        area.y + 1,
+        area.width,
+        &format!(" {}", config.custom.title),
+        Style::default()
+            .fg(palette.overlay0)
+            .add_modifier(Modifier::BOLD),
+    );
+    // Leave the last two columns for the « collapse toggle on the bottom row.
+    let line_width = area.width.saturating_sub(3);
+    for (row, line) in snapshot
+        .sidebar_custom_lines
+        .iter()
+        .take(usize::from(area.height - CUSTOM_SECTION_HEADER_ROWS))
+        .enumerate()
+    {
+        put_text(
+            buffer,
+            area.x + 1,
+            area.y + CUSTOM_SECTION_HEADER_ROWS + row as u16,
+            line_width,
+            line,
+            Style::default().fg(palette.text),
+        );
+    }
+}
+
+const LAUNCHER_COLUMNS: u16 = 3;
+/// Icon row plus label row.
+const LAUNCHER_TILE_ROWS: u16 = 2;
+
+fn launchers(
+    snapshot: &ClientShellSnapshot,
+) -> impl Iterator<Item = (&str, &crate::protocol::ClientShellLauncher)> {
+    snapshot.commands.iter().filter_map(|command| {
+        let launcher = command.launcher.as_ref()?;
+        Some((command.command_id.as_str(), launcher))
+    })
+}
+
+/// Fork: carves the launcher grid off the bottom of the sidebar content.
+fn split_launcher_section(area: Rect, snapshot: &ClientShellSnapshot) -> (Rect, Rect) {
+    let count = launchers(snapshot).count() as u16;
+    if count == 0 {
+        return (area, Rect::default());
+    }
+    let grid_rows = count.div_ceil(LAUNCHER_COLUMNS);
+    let height = (CUSTOM_SECTION_HEADER_ROWS + grid_rows * LAUNCHER_TILE_ROWS)
+        .min(area.height.saturating_sub(MIN_SPACES_AND_AGENTS_ROWS));
+    if height < CUSTOM_SECTION_HEADER_ROWS + LAUNCHER_TILE_ROWS {
+        return (area, Rect::default());
+    }
+    let agents = Rect {
+        height: area.height - height,
+        ..area
+    };
+    (
+        agents,
+        Rect::new(area.x, agents.bottom(), area.width, height),
+    )
+}
+
+fn render_launcher_section(
+    buffer: &mut Buffer,
+    area: Rect,
+    snapshot: &ClientShellSnapshot,
+    config: &ClientShellConfig,
+    hits: &mut ShellHitMap,
+) {
+    if area.height < CUSTOM_SECTION_HEADER_ROWS + LAUNCHER_TILE_ROWS {
+        return;
+    }
+    let palette = &config.palette;
+    put_text(
+        buffer,
+        area.x,
+        area.y,
+        area.width,
+        &"─".repeat(area.width as usize),
+        Style::default().fg(palette.surface_dim),
+    );
+    put_text(
+        buffer,
+        area.x,
+        area.y + 1,
+        area.width,
+        " launch",
+        Style::default()
+            .fg(palette.overlay0)
+            .add_modifier(Modifier::BOLD),
+    );
+    // Leave the last two columns for the « collapse toggle on the bottom row.
+    let grid_width = area.width.saturating_sub(2);
+    let tile_width = grid_width / LAUNCHER_COLUMNS;
+    if tile_width == 0 {
+        return;
+    }
+    let visible_rows = (area.height - CUSTOM_SECTION_HEADER_ROWS) / LAUNCHER_TILE_ROWS;
+    for (index, (command_id, launcher)) in launchers(snapshot)
+        .take(usize::from(visible_rows * LAUNCHER_COLUMNS))
+        .enumerate()
+    {
+        let index = index as u16;
+        let tile = Rect::new(
+            area.x + (index % LAUNCHER_COLUMNS) * tile_width,
+            area.y + CUSTOM_SECTION_HEADER_ROWS + (index / LAUNCHER_COLUMNS) * LAUNCHER_TILE_ROWS,
+            tile_width,
+            LAUNCHER_TILE_ROWS,
+        );
+        put_centered(buffer, tile, tile.y, &launcher.icon, palette.accent);
+        put_centered(buffer, tile, tile.y + 1, &launcher.label, palette.overlay1);
+        hits.launchers.push((tile, command_id.to_owned()));
+    }
+}
+
+fn put_centered(buffer: &mut Buffer, tile: Rect, y: u16, text: &str, color: ratatui::style::Color) {
+    let width = display_width(text).min(tile.width);
+    let x = tile.x + (tile.width - width) / 2;
+    put_text(buffer, x, y, width, text, Style::default().fg(color));
+}
