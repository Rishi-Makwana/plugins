+#[test]
+fn launcher_tiles_render_in_a_grid_and_click_invokes_their_command() {
+    let mut state = ClientShellState::new(ClientShellConfig::from_config(&Config::default()));
+    let mut snapshot = snapshot();
+    for (index, label) in ["Chrome", "Confluence", "VS Code", "Slack"]
+        .iter()
+        .enumerate()
+    {
+        snapshot.commands.push(launcher_command(
+            &format!("cmd_launch_{index}"),
+            &label[..1],
+            label,
+        ));
+    }
+    state.set_snapshot(Box::new(snapshot));
+    state.set_pane_surface(surface());
+    let shell = state.compose(106, 30).expect("launcher frame");
+    let rows: Vec<String> = shell
+        .cells
+        .chunks(106)
+        .map(|row| {
+            row.iter()
+                .take(26)
+                .map(|cell| cell.symbol.as_str())
+                .collect()
+        })
+        .collect();
+
+    let tiles = state.hits.launchers.clone();
+    assert_eq!(tiles.len(), 4);
+    assert_eq!(tiles[0].0.y, tiles[2].0.y, "three tiles per row");
+    assert_eq!(
+        tiles[3].0.y,
+        tiles[0].0.y + 2,
+        "fourth tile wraps to the next row"
+    );
+    assert!(tiles[1].0.x > tiles[0].0.x);
+    let first = tiles[0].0;
+    assert!(
+        rows[usize::from(first.y)].contains('C'),
+        "icon row:\n{}",
+        rows.join("\n")
+    );
+    assert!(rows[usize::from(first.y) + 1].contains("Chrome"));
+    assert!(rows[usize::from(first.y) - 1].contains(" launch"));
+    assert_eq!(
+        tiles[3].0.bottom(),
+        30,
+        "launcher grid ends at the sidebar bottom"
+    );
+
+    let (rect, command_id) = &tiles[1];
+    let mut clicked = ClientShellInput::default();
+    for kind in [
+        MouseEventKind::Down(MouseButton::Left),
+        MouseEventKind::Up(MouseButton::Left),
+    ] {
+        let outcome =
+            state.handle_raw_events(vec![RawInputEvent::Mouse(crossterm::event::MouseEvent {
+                kind,
+                column: rect.x + 1,
+                row: rect.y,
+                modifiers: KeyModifiers::empty(),
+            })]);
+        clicked.actions.extend(outcome.actions);
+    }
+    let [ClientShellAction::Endpoint { request, .. }] = &clicked.actions[..] else {
+        panic!("launcher click should send one endpoint request");
+    };
+    assert!(matches!(
+        &request.method,
+        crate::api::schema::Method::CommandInvoke(params) if &params.command_id == command_id
+    ));
+}
