+/// Keeps the first bytes and drains the rest so the child never blocks on a full pipe.
+async fn read_capped_output(mut stdout: tokio::process::ChildStdout) -> std::io::Result<Vec<u8>> {
+    let mut output = Vec::new();
+    let mut buffer = [0_u8; 1024];
+    loop {
+        let count = stdout.read(&mut buffer).await?;
+        if count == 0 {
+            return Ok(output);
+        }
+        let room = MAX_SIDEBAR_CUSTOM_OUTPUT_BYTES.saturating_sub(output.len());
+        output.extend_from_slice(&buffer[..count.min(room)]);
+    }
+}
